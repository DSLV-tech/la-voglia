---
import { asset } from '@/lib/asset';
const shots = [
  { src: 'foto_bancone.webp', alt: 'Bancone', cls: 'tall' },
  { src: 'bancone.webp', alt: 'Bancone', cls: '' },
  { src: 'spillatrice.webp', alt: 'Feste', cls: '' },
  { src: 'interno.webp', alt: 'Birre', cls: 'wide' },
];
---
<section id="gallery">
  <div class="container" style="text-align:center">
    <div class="reveal">
      <p class="section-label">L'ambiente</p>
      <h2 class="section-title">Un pub con <span>carattere</span></h2>
      <div class="section-line" style="margin:0 auto"></div>
      <p style="color:var(--ts);max-width:560px;margin:0 auto;font-size:1.05rem">Legno caldo, bancone storico, scaffali carichi di bottiglie — un'atmosfera autentica che si respira dal primo passo dentro La Voglia.</p>
    </div>
  </div>
  <div class="gallery-grid reveal">
    {shots.map((s) => (
      <div class={`gallery-img ${s.cls}`.trim()}>
        <img src={asset(s.src)} alt={s.alt} loading="lazy" />
      </div>
    ))}
  </div>
</section>
