---
import { asset } from '@/lib/asset';
---
<section class="hero">
  <div class="hero-bg-img">
    <img src="https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?w=1600&q=80" alt="Pub" />
  </div>
  <div class="hero-badge">Vercelli · Est. 1989</div>
  <div class="hero-logo-wrap"><img src={asset('logo.png')} alt="La Voglia" /></div>
  <p class="hero-sub">Pub · Birreria · Bar — Vercelli</p>
  <div class="hero-divider"></div>
  <p class="hero-tagline">Un posto storico dove ogni birra racconta una storia, ogni panino è una scoperta.</p>
  <div class="hero-cta">
    <a href="#birre" class="btn-primary">Le Nostre Birre</a>
    <a href="#menu" class="btn-outline">100 Panini</a>
    <a href="#tripadvisor" class="btn-ta">★ Recensioni</a>
  </div>
</section>
